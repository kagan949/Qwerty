# ---------------------------------------------------------------------------
# VYBE environment variables
# ---------------------------------------------------------------------------
# All music sources below are legal, publicly accessible catalogues that do
# NOT require an API key for read access. The app works with zero configuration.
# Keys are OPTIONAL: Jamendo keys only unlock higher rate limits / extra fields.
#
# IMPORTANT: the Jamendo key is used ONLY on the server (route handlers) and is
# never shipped to the browser. Do not prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Optional — create a free app at https://developer.jamendo.com
# Without it, the server uses a shared public demo key.
JAMENDO_CLIENT_ID=

# Optional — override the Internet Archive S3 host used for audio files.
# Default: https://archive.org
INTERNET_ARCHIVE_HOST=https://archive.org

# Optional — a private token appended to Archive.org media URLs for
# higher-throughput nodes. Leave blank for public usage.
INTERNET_ARCHIVE_TOKEN=

# Optional — comma separated hostnames allowed to be proxied by /api/audio.
# Defaults cover archive.org, jamendo and fmstream hosts.
AUDIO_PROXY_ALLOWED_HOSTS=

# Optional — override the public base URL used for OpenGraph/metadata.
NEXT_PUBLIC_SITE_URL=https://vybe.vercel.app
